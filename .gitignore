*.mp4
*.mov
*.wav
*.png
*.jpg
weights/
checkpoints/
*.safetensors
*.ckpt
*.pth
*.bin

# Benchmark run data (kept out of VCS; reports are exported on demand)
benchmarks/runs/*
!benchmarks/runs/.gitkeep

# Local config / secrets
.env
*.local.yaml
config/local/

# OS / editor
.DS_Store
.idea/
.vscode/
